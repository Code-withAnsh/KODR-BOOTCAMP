    {
      "id": "xhf63uAq5l3q51vziKe_5",
      "type": "text",
      "x": 551.8908661292779,
      "y": 2069.706239025999,
      "width": 568.4996337890625,
      "height": 400,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1W",
      "roundness": null,
      "seed": 296646297,
      "version": 777,
      "versionNonce": 1951516983,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794768474871,
      "link": null,
      "locked": false,
      "text": "jab user koi req bhejta hai to the server\n\ntoh uske saath jata hai uska token server uss\ntoken ko decode karke dekhta hai ki ye kis\nuser se aa rhi hai lekin socho user kya ek hi cheez\nke liye req bhejta hai? application me multiple functions hai\njjisko user use karta hai aur wo user use isliye kar\npata  hai becouse uske saath uska req jata hai jisme\nuska token hota hai aur server use decode karta hai\ntoh kya her req ke saath agar server her time token \ndecode karega toh ye ek unoptimise tareeka nhi hai?\nha toh ise handle karte hai through controller\njo ek baar me decode kar deta hai aur ab her api\nke liye req controller ke through jata hai \n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "jab user koi req bhejta hai to the server\n\ntoh uske saath jata hai uska token server uss\ntoken ko decode karke dekhta hai ki ye kis\nuser se aa rhi hai lekin socho user kya ek hi cheez\nke liye req bhejta hai? application me multiple functions hai\njjisko user use karta hai aur wo user use isliye kar\npata  hai becouse uske saath uska req jata hai jisme\nuska token hota hai aur server use decode karta hai\ntoh kya her req ke saath agar server her time token \ndecode karega toh ye ek unoptimise tareeka nhi hai?\nha toh ise handle karte hai through controller\njo ek baar me decode kar deta hai aur ab her api\nke liye req controller ke through jata hai \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
